# Copy to .env (never committed) and fill in. All variables are optional in dev.

# dev | ci | prod
GRIDCAST_ENV=dev

# Where bronze/silver/gold data live (default: ./data)
# GRIDCAST_DATA_DIR=/absolute/path/to/data

# DEBUG | INFO | WARNING | ERROR
GRIDCAST_LOG_LEVEL=INFO

# [OWNER] Email or URL in our User-Agent so data providers can contact us.
GRIDCAST_CONTACT=

# Seconds between requests to one host; must be >= 1.0 (polite-client rule).
GRIDCAST_HTTP_MIN_INTERVAL_S=1.0

# [OWNER] Grid Status hosted API key, only if ADR-001 picks that backfill route.
GRIDSTATUS_API_KEY=
